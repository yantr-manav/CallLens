# CallLens n8n infra — secrets. Copy to `.env` next to docker-compose.yml
# (`cp .env.example .env`) and fill in real values. NEVER commit `.env`.

# A long random string used to encrypt n8n credentials at rest.
# Generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Editor login (basic auth) — choose a strong password.
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=

# The PUBLIC URL n8n advertises for webhook callbacks.
# With a Cloudflare named tunnel pointed at this instance, use the tunnel URL:
#   https://n8n.<your-tunnel-domain>
# This is the same base URL that NEXT.js will set as N8N_WEBHOOK_URL
# (with /webhook/calllens-analyze appended by the workflow).
WEBHOOK_URL=

# Shared HMAC secret used to sign Next.js -> n8n webhook calls.
# Must equal the N8N_WEBHOOK_SECRET in the Next.js .env.local.
N8N_WEBHOOK_SECRET=

# Google Gemini API key (free tier). Used inside the n8n "Build Request"
# Code node as the x-goog-api-key header. Get one at https://aistudio.google.com
GEMINI_API_KEY=

# Cloudflare Tunnel token (optional). Enables the `cloudflared` service.
# Create a named tunnel at https://one.dash.cloudflare.com → Networks/Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=