# ─────────────────────────────────────────────────────────────
# CallLens — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# The app runs in a fully-functional LOCAL DEMO MODE when these
# are absent (local JSON store + dev auth + deterministic mock
# analyzer). Filling them flips the app to real Supabase + n8n.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n orchestration (your self-hosted n8n webhook)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# LLM — used inside n8n, never the frontend (kept here for the n8n .env + docs)
GEMINI_API_KEY=

# Rate limiting (Upstash Redis). Optional — in-memory limiter is used when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth bypass credentials for LOCAL DEMO MODE only (ignored once Supabase is configured)
DEMO_USER_EMAIL=demo@calllens.local
DEMO_USER_PASSWORD=calllens