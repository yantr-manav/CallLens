# ─────────────────────────────────────────────────────────────
# CallLens — Environment Variables (TEMPLATE — copy to `.env.local`)
# Never commit real values. Fill the copied file with your secrets.
# The app runs in a fully-functional LOCAL DEMO MODE when these
# are absent; filling them flips the app to real Supabase + n8n.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
# NOTE: this is the project API URL, NOT the postgres connection string.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Direct Postgres connection (migrations / scripts).
# asyncpg driver format — percent-encode special chars in the password.
# Session-mode pooler (port 6543): the direct host db.<ref>.supabase.co is
# IPv6-only; use the IPv4 pooler aws-0-<region>.pooler.supabase.com with
# user postgres.<project-ref>.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# n8n orchestration — FULL production webhook URL of the imported workflow.
# n8n Cloud: https://<your-subdomain>.app.n8n.cloud/webhook/calllens-analyze
N8N_WEBHOOK_URL=https://<your-subdomain>.app.n8n.cloud/webhook/calllens-analyze
# Shared secret for the HMAC-SHA256 webhook signature. It must match the value
# baked into the workflow's "Config" node — run
#   node scripts/build-n8n-workflow.mjs
# with this and GROQ_API_KEY exported, then import the generated
# n8n/CALLLENS_ANALYZE_CONVERSATION.local.json so the two can never drift.
N8N_WEBHOOK_SECRET=

# Groq — baked into the n8n workflow AND used by the in-app fallback engine
# (lib/groq.ts, server-only). Never expose it to the browser: do NOT rename this
# with a NEXT_PUBLIC_ prefix.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_<your-groq-key>

# Optional engine timeout overrides (milliseconds). Defaults shown.
# N8N_TIMEOUT_MS=12000
# N8N_COLD_START_TIMEOUT_MS=22000
# GROQ_TIMEOUT_MS=20000

# Cookie signing secret (demo-mode auth HMAC). Set a strong value in production.
AUTH_SECRET=

# Rate limiting (Upstash Redis). Optional — in-memory limiter is used when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth bypass credentials for LOCAL DEMO MODE only (ignored once Supabase is configured)
DEMO_USER_EMAIL=demo@calllens.local
DEMO_USER_PASSWORD=calllens